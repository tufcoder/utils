# Define cores para uso no prompt
NORMAL="\[\033[0m\]"
AZUL="\[\033[01;34m\]"
VERDE="\[\033[01;32m\]"

# Função para obter o status do Git (branch)
parse_git_branch() {
    local branch_name=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

    if [[ -n "$branch_name" && "$branch_name" != "HEAD" ]]; then
        echo " (${branch_name})"
    elif [[ "$branch_name" == "HEAD" ]]; then
        local commit_hash=$(git rev-parse --short HEAD 2>/dev/null)
        if [[ -n "$commit_hash" ]]; then
            echo " (detached-$commit_hash)"
        fi
    fi
}

# Define o prompt principal (PS1)
export PS1="${NORMAL}${VERDE}\$(parse_git_branch)${NORMAL}\$ "

export PATH="$PATH:$HOME/.cargo/bin"

export EDITOR=vim

# PHP e o Composer costumam mexer com milhares de arquivos simultaneamente
ulimit -n 65535

# pnpm
export PNPM_HOME="/home/tuf/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# Garante que o diretório de binários locais do usuário esteja no PATH para encontrar o mise
export PATH="$HOME/.local/bin:$PATH"

# Ativa o mise
eval "$(mise activate bash)"
